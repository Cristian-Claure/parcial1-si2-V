# PostgreSQL
VELORA_DB_HOST=localhost
VELORA_DB_PORT=55432
VELORA_DB_NAME=velora_db
VELORA_DB_USER=velora
VELORA_DB_PASSWORD=change_me
DATABASE_URL=postgresql://velora:change_me@127.0.0.1:55432/velora_db
PORT=8080

# Security
VELORA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VELORA_JWT_SECRET=change-me-with-a-random-32-byte-or-longer-secret
VELORA_JWT_EXPIRATION_MINUTES=120
VELORA_AUTH_RATE_LIMIT_MAX_REQUESTS=10
VELORA_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
VELORA_RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Stripe real
# Test: sk_test_... / whsec_...
# Producción requiere una cuenta Stripe habilitada en una jurisdicción soportada.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/pago/stripe/retorno
STRIPE_CANCEL_URL=http://localhost:5173/mis-pedidos
VELORA_PUBLIC_BACKEND_URL=http://127.0.0.1:8080

# Product Assistant · OpenAI Responses API
# OPENAI_API_KEY es exclusivamente backend.
OPENAI_API_KEY=
VELORA_AI_MODEL=gpt-5.6-luna
VELORA_AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VELORA_AI_MAX_CATALOG_PRODUCTS=120
VELORA_OPENAI_BASE_URL=https://api.openai.com/v1

# Virtual Try-On generation provider: LOCAL | REPLICATE
VELORA_TRYON_PROVIDER=LOCAL
VELORA_TRYON_LOCAL_URL=
VELORA_TRYON_LOCAL_MODEL=
REPLICATE_API_TOKEN=
VELORA_REPLICATE_BASE_URL=https://api.replicate.com/v1
VELORA_TRYON_REPLICATE_MODEL=prunaai/p-image-try-on
VELORA_TRYON_MAX_INPUT_BYTES=5242880
VELORA_TRYON_PROVIDER_TIMEOUT_SECONDS=30
VELORA_TRYON_RESULT_MAX_BYTES=12582912

# Managed asset storage: LOCAL | AZURE_BLOB
# LOCAL para desarrollo. AZURE_BLOB para Azure y para pruebas con Azurite.
VELORA_ASSET_STORAGE_PROVIDER=LOCAL
VELORA_ASSET_LOCAL_DIR=./storage/assets
AZURE_STORAGE_CONNECTION_STRING=
VELORA_AZURE_BLOB_CONTAINER=velora-assets

# Firebase Cloud Messaging HTTP v1 · backend only
VELORA_PUSH_FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=velora-784de
FIREBASE_CLIENT_EMAIL=
# En Azure guarde la clave privada completa como secreto/app setting, nunca en Git.
FIREBASE_PRIVATE_KEY=

# Admin bootstrap · disabled by default
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=Velora

# React + Vite storefront
VITE_API_BASE_URL=http://127.0.0.1:8080
# Déjelo vacío para seleccionar explícitamente la Company si existe más de una.
VITE_STOREFRONT_COMPANY_ID=

# React Native + Expo CUSTOMER
# Android Emulator usa 10.0.2.2 para alcanzar localhost del host.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
# Déjelo vacío para seleccionar explícitamente Company cuando existe más de una.
EXPO_PUBLIC_STOREFRONT_COMPANY_ID=

# Azure production reference (examples only; do not commit real secrets)
# API: Azure App Service (Linux / Node.js). Azure injects PORT; Nest already binds 0.0.0.0.
# Web: Azure Static Web Apps. Set VITE_* at build time.
# DB: Azure Database for PostgreSQL Flexible Server. Keep TLS enabled and verify the server certificate.
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/velora_db?sslmode=verify-full
# VELORA_CORS_ALLOWED_ORIGINS=https://<your-web>.azurestaticapps.net
# VELORA_RATE_LIMIT_TRUST_PROXY_HEADERS=true
# VELORA_PUBLIC_BACKEND_URL=https://<your-api>.azurewebsites.net
# STRIPE_SUCCESS_URL=https://<your-web>.azurestaticapps.net/pago/stripe/retorno
# STRIPE_CANCEL_URL=https://<your-web>.azurestaticapps.net/mis-pedidos
# VELORA_ASSET_STORAGE_PROVIDER=AZURE_BLOB
# AZURE_STORAGE_CONNECTION_STRING=<set-as-an-Azure-App-Service-secret>
# VELORA_AZURE_BLOB_CONTAINER=velora-assets
# VELORA_PUSH_FIREBASE_ENABLED=true
# FIREBASE_PROJECT_ID=velora-784de
# FIREBASE_CLIENT_EMAIL=<service-account-client-email>
# FIREBASE_PRIVATE_KEY=<set-as-an-Azure-App-Service-secret>
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=<initial-admin-email>
# BOOTSTRAP_ADMIN_PASSWORD=<set-as-an-Azure-App-Service-secret>
# Disable BOOTSTRAP_ADMIN_ENABLED after initial provisioning if you no longer need startup bootstrap.
# VITE_API_BASE_URL=https://<your-api>.azurewebsites.net
# EXPO_PUBLIC_API_BASE_URL=https://<your-api>.azurewebsites.net
