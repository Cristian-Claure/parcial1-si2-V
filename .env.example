VELORA_DB_HOST=localhost
VELORA_DB_PORT=55432
VELORA_DB_NAME=velora_db
VELORA_DB_USER=velora
VELORA_DB_PASSWORD=change_me
# Stripe real
# Test: sk_test_... / whsec_...
# Produccion requiere una cuenta Stripe habilitada
# en una jurisdiccion soportada por Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4200/pago/stripe/retorno
STRIPE_CANCEL_URL=http://localhost:4200/mis-pedidos
# VÉLORA AI · Product Assistant
# No comparta OPENAI_API_KEY ni el token interno en el frontend.
OPENAI_API_KEY=
VELORA_AI_MODEL=gpt-5.6-luna
VELORA_AI_INTERNAL_TOKEN=
VELORA_AI_BASE_URL=http://127.0.0.1:8001
VELORA_BACKEND_URL=http://127.0.0.1:8080
VELORA_AI_MAX_CATALOG_PRODUCTS=120
